VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
VITE_API_BASE_URL=

# Electron AI mode (keep bootstrap/access tokens out of source control)
AI_PROVIDER=mock
AI_BACKEND_URL=http://127.0.0.1:8787
AI_ACCESS_TOKEN=
AI_BOOTSTRAP_TOKEN=
AI_BACKEND_PROVIDER=ollama
OLLAMA_MODEL=qwen3-coder:30b


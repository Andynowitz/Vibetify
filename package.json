{
  "name": "vibetify",
  "version": "0.1.0",
  "description": "A premium AI music workspace for Windows.",
  "main": "dist-electron/main.js",
  "author": "Vibetify",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5174\" \"wait-on http://127.0.0.1:5174 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "dev:full": "concurrently -k -n BACKEND,ELECTRON -c blue,green \"npm:backend:dev\" \"npm:dev\"",
    "build": "npm run build:renderer && npm run build:electron",
    "build:backend": "tsc -p backend/tsconfig.json",
    "backend:dev": "npm run build:backend && node dist-backend/backend/server.js",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "package:win": "npm run build && electron-builder --win --x64",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit && tsc -p backend/tsconfig.json --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.vibetify.desktop",
    "productName": "Vibetify",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
